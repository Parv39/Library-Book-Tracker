#!/bin/bash
# junk_cleaner_restore.sh
# Safe Junk Cleaner with Restore Mode

GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
NC="\033[0m"

BACKUP_DIR="$HOME/.junk_backup"
mkdir -p "$BACKUP_DIR"

CACHE_DIRS=("/var/cache" "$HOME/.cache")
TEMP_DIRS=("/tmp")
LOG_DIRS=("/var/log")

# ===============================
# RESTORE MODE
# ===============================
if [[ $1 == "--restore" ]]; then
    echo -e "${YELLOW}=============================="
    echo -e "   RESTORE MODE ACTIVATED"
    echo -e "==============================${NC}"
    echo

    if [ -z "$(ls -A $BACKUP_DIR 2>/dev/null)" ]; then
        echo -e "${RED}No backup files found in $BACKUP_DIR.${NC}"
        exit 1
    fi

    echo -e "${GREEN}Restoring files from backup...${NC}"
    sudo mv "$BACKUP_DIR"/* /tmp/ 2>/dev/null
    echo -e "${GREEN}Files restored to /tmp for safety.${NC}"
    echo -e "${YELLOW}You can manually move them back where needed.${NC}"
    exit 0
fi

# ===============================
# NORMAL CLEANING MODE
# ===============================
echo -e "${YELLOW}=============================="
echo -e "   SAFE LINUX JUNK CLEANER"
echo -e "==============================${NC}"
echo

echo -e "${GREEN}Scanning junk files...${NC}"
sleep 1
du -sh ${CACHE_DIRS[@]} ${TEMP_DIRS[@]} ${LOG_DIRS[@]} 2>/dev/null
echo

read -p "Do you want to move these junk files to backup? (y/n): " choice
if [[ $choice != [Yy]* ]]; then
    echo -e "${RED}Cleanup cancelled.${NC}"
    exit 0
fi

echo -e "${YELLOW}Moving junk files to $BACKUP_DIR...${NC}"
for dir in "${CACHE_DIRS[@]}" "${TEMP_DIRS[@]}" "${LOG_DIRS[@]}"; do
    if [ -d "$dir" ]; then
        sudo mv "$dir"/* "$BACKUP_DIR"/ 2>/dev/null
    fi
done
echo -e "${GREEN}Files safely moved to $BACKUP_DIR.${NC}"

echo
read -p "Do you want to permanently delete backup files now? (y/n): " del_choice
if [[ $del_choice == [Yy]* ]]; then
    rm -rf "$BACKUP_DIR"/*
    echo -e "${GREEN}Backup folder emptied permanently.${NC}"
else
    echo -e "${YELLOW}Backup retained at: $BACKUP_DIR${NC}"
    echo "You can restore files anytime using:"
    echo -e "${GREEN}./junk_cleaner_restore.sh --restore${NC}"
fi
